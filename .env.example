# Copy to .env for local generation only. Never commit real credentials.
# Gemini API (Google AI Studio 免费层 - 推荐首选)
GEMINI_API_KEY=
BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
MODEL=gemini-2.0-flash

# DeepSeek API (备选)
# DEEPSEEK_API_KEY=
# BASE_URL=https://api.deepseek.com
# MODEL=deepseek-v4-pro

PROXY_URL=http://127.0.0.1:7892
RSSHUB_URL=

# Optional absolute path to an ignored, private diary payload.
DIARY_SNIPPETS_FILE=
